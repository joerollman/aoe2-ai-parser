{
  "name": "aoe2-ai-parser-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:rms": "node scripts/lint-rms.mjs",
    "verify:editor-extension": "node scripts/verify-cursor-extension.mjs",
    "verify:cursor-extension": "node scripts/verify-cursor-extension.mjs",
    "sync:extension-lab": "node scripts/sync-extension-lab.mjs",
    "smoke:cursor-completions": "node scripts/smoke-cursor-completions.mjs",
    "smoke:cursor-package-output": "node scripts/smoke-cursor-package-output.mjs",
    "package:editor-extension": "node scripts/install-cursor-extension.mjs --package-only",
    "publish:vscode-extension": "node scripts/publish-extension.mjs vscode",
    "publish:openvsx-extension": "node scripts/publish-extension.mjs openvsx",
    "install:cursor-extension": "node scripts/install-cursor-extension.mjs --editor cursor",
    "install:cursor-extension:bump": "node scripts/install-cursor-extension.mjs --editor cursor --bump-patch",
    "install:vscode-extension": "node scripts/install-cursor-extension.mjs --editor code",
