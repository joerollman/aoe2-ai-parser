{
  "$schema": "vscode://schemas/color-theme",
  "name": "AOE2 AI Parser Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#FAFBFC",
    "editor.foreground": "#24292F",
    "editorLineNumber.foreground": "#8C959F",
    "editorLineNumber.activeForeground": "#57606A",
    "editorCursor.foreground": "#24292F",
    "editor.selectionBackground": "#BBDFFF",
    "editor.inactiveSelectionBackground": "#DDEEFF",
    "editor.lineHighlightBackground": "#F1F5F9",
    "editorWhitespace.foreground": "#D0D7DE",
    "editorIndentGuide.background1": "#D8DEE4",
    "editorIndentGuide.activeBackground1": "#8C959F"
  },
  "semanticTokenColors": {
    "aoe2Action": "#0550AE",
    "aoe2Fact": "#6F42C1",
    "aoe2FactAction": "#008B8B",
    "aoe2Command": "#7A5B00",
    "aoe2StrategicNumber": "#0A7EA4",
    "aoe2Object": "#B35900",
    "aoe2Tech": "#22863A",
    "aoe2Value": "#6E5A00",
    "aoe2LocalConstant": "#116329",
    "aoe2Action:aoe2aiscript": "#0550AE",
    "aoe2Fact:aoe2aiscript": "#6F42C1",
    "aoe2FactAction:aoe2aiscript": "#008B8B",
    "aoe2Command:aoe2aiscript": "#7A5B00",
    "aoe2StrategicNumber:aoe2aiscript": "#0A7EA4",
    "aoe2Object:aoe2aiscript": "#B35900",
    "aoe2Tech:aoe2aiscript": "#22863A",
    "aoe2Value:aoe2aiscript": "#6E5A00",
    "aoe2LocalConstant:aoe2aiscript": "#116329"
  },
  "tokenColors": [
    {
      "scope": [
        "comment.line.semicolon",
        "comment.line.double-slash"
      ],
      "settings": {
        "foreground": "#6E7781",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.aoe2aiscript",
      "settings": {
        "foreground": "#24292F"
      }
    },
    {
      "scope": "constant.numeric.aoe2aiscript",
      "settings": {
        "foreground": "#57606A"
      }
    },
    {
      "scope": [
        "storage.type.aoe2aiscript.def.rule",
        "storage.type.aoe2aiscript.def.const",
        "keyword.control.aoe2aiscript.control",
        "keyword.control.aoe2aiscript.load.if",
        "keyword.control.aoe2aiscript.load.elseend",
        "keyword.control.aoe2aiscript.load.file",
        "support.type.aoe2aiscript.yields"
      ],
      "settings": {
        "foreground": "#7A5B00"
      }
    },
    {
      "scope": "entity.name.function.aoe2aiscript.action",
      "settings": {
        "foreground": "#0550AE"
      }
    },
    {
      "scope": "entity.name.function.aoe2aiscript.fact",
      "settings": {
        "foreground": "#6F42C1"
      }
    },
    {
      "scope": "support.constant.strategic-number.aoe2aiscript",
      "settings": {
        "foreground": "#0A7EA4"
      }
    },
    {
      "scope": "constant.other.object.aoe2aiscript",
      "settings": {
        "foreground": "#B35900"
      }
    },
    {
      "scope": "aoe2aiscript.tech",
      "settings": {
        "foreground": "#22863A"
      }
    },
    {
      "scope": [
        "constant.other.value.aoe2aiscript",
        "variable.other.aoe2aiscript.resource",
        "constant.language.aoe2aiscript.truefalse"
      ],
      "settings": {
        "foreground": "#6E5A00"
      }
    },
    {
      "scope": "variable.other.constant.aoe2aiscript",
      "settings": {
        "foreground": "#116329"
      }
    }
  ]
}
