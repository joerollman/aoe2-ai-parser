{
  "$schema": "vscode://schemas/color-theme",
  "name": "AOE2 AI Parser Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#101418",
    "editor.foreground": "#D7DEE8",
    "editorLineNumber.foreground": "#69727D",
    "editorLineNumber.activeForeground": "#B8C0CC",
    "editorCursor.foreground": "#F6F8FA",
    "editor.selectionBackground": "#28476A",
    "editor.inactiveSelectionBackground": "#1E334A",
    "editor.lineHighlightBackground": "#161C23",
    "editorWhitespace.foreground": "#343B44",
    "editorIndentGuide.background1": "#2A313A",
    "editorIndentGuide.activeBackground1": "#6F7A86"
  },
  "semanticTokenColors": {
    "aoe2Action": "#5DADEC",
    "aoe2Fact": "#C69CFF",
    "aoe2FactAction": "#38C2B3",
    "aoe2Command": "#D7A72F",
    "aoe2StrategicNumber": "#4CC2FF",
    "aoe2Object": "#F0A35E",
    "aoe2Tech": "#8FD694",
    "aoe2Value": "#D6C56F",
    "aoe2LocalConstant": "#57D68D",
    "aoe2Action:aoe2aiscript": "#5DADEC",
    "aoe2Fact:aoe2aiscript": "#C69CFF",
    "aoe2FactAction:aoe2aiscript": "#38C2B3",
    "aoe2Command:aoe2aiscript": "#D7A72F",
    "aoe2StrategicNumber:aoe2aiscript": "#4CC2FF",
    "aoe2Object:aoe2aiscript": "#F0A35E",
    "aoe2Tech:aoe2aiscript": "#8FD694",
    "aoe2Value:aoe2aiscript": "#D6C56F",
    "aoe2LocalConstant:aoe2aiscript": "#57D68D"
  },
  "tokenColors": [
    {
      "scope": [
        "comment.line.semicolon",
        "comment.line.double-slash"
      ],
      "settings": {
        "foreground": "#87919D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.aoe2aiscript",
      "settings": {
        "foreground": "#D7DEE8"
      }
    },
    {
      "scope": "constant.numeric.aoe2aiscript",
      "settings": {
        "foreground": "#B8C0CC"
      }
    },
    {
      "scope": [
        "storage.type.aoe2aiscript.def.rule",
        "storage.type.aoe2aiscript.def.const",
        "keyword.control.aoe2aiscript.control",
        "keyword.control.aoe2aiscript.load.if",
        "keyword.control.aoe2aiscript.load.elseend",
        "keyword.control.aoe2aiscript.load.file",
        "support.type.aoe2aiscript.yields"
      ],
      "settings": {
        "foreground": "#D7A72F"
      }
    },
    {
      "scope": "entity.name.function.aoe2aiscript.action",
      "settings": {
        "foreground": "#5DADEC"
      }
    },
    {
      "scope": "entity.name.function.aoe2aiscript.fact",
      "settings": {
        "foreground": "#C69CFF"
      }
    },
    {
      "scope": "support.constant.strategic-number.aoe2aiscript",
      "settings": {
        "foreground": "#4CC2FF"
      }
    },
    {
      "scope": "constant.other.object.aoe2aiscript",
      "settings": {
        "foreground": "#F0A35E"
      }
    },
    {
      "scope": "aoe2aiscript.tech",
      "settings": {
        "foreground": "#8FD694"
      }
    },
    {
      "scope": [
        "constant.other.value.aoe2aiscript",
        "variable.other.aoe2aiscript.resource",
        "constant.language.aoe2aiscript.truefalse"
      ],
      "settings": {
        "foreground": "#D6C56F"
      }
    },
    {
      "scope": "variable.other.constant.aoe2aiscript",
      "settings": {
        "foreground": "#57D68D"
      }
    }
  ]
}
