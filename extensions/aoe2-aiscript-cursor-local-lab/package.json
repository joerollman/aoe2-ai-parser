{
	"name": "aoe2-ai-parser",
	"displayName": "AOE2 AI Parser",
	"description": "Parser diagnostics, command tooltips, syntax highlighting, and autocomplete for Age of Empires 2 AI scripts in VS Code and Cursor",
	"version": "0.1.47",
	"keywords": [
		"aoeII",
		"age",
		"empires",
		"age of empires",
		"ai scripting"
	],
	"license": "GPL-3.0-or-later",
	"author": "AOE2 AI Scripters",
	"publisher": "aoe2-ai-scripters",
	"icon": "images/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/joerollman/aoe2-ai-parser.git"
	},
	"activationEvents": [
		"onLanguage:aoe2aiscript",
		"onCommand:aoe2AiScript.lintCurrentFile",
		"onCommand:aoe2AiScript.lintPackage",
		"onCommand:aoe2AiScript.generatePackageReport",
		"onCommand:aoe2AiScript.openLatestPackageReport",
		"onCommand:aoe2AiScript.openSymbolDocsPreview",
		"onCommand:aoe2AiScript.openDiagnosticDocsPreview"
	],
	"main": "./languageExtension/out/extension",
	"categories": [
		"Programming Languages",
		"Linters",
		"Snippets"
	],
	"contributes": {
		"languages": [
			{
				"id": "aoe2aiscript",
				"aliases": [
					"Aoe2 AiScript",
					"aoe2aiscript"
				],
				"extensions": [
					".per",
					".ai"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "AOE2 AI Parser",
			"properties": {
				"aoe2_AiScript.updateErrorsWhen": {
					"scope": "resource.aiscript",
					"type": "string",
					"enum": [
						"never",
						"onSave",
						"onChange"
					],
					"default": "onSave",
					"description": "Controls when error squiggles are updated. Default: update only when the file is saved. Change to 'onChange' to update whenever the file is edited (this may have some performance cost for large files)."
				},
				"aoe2_AiScript.maxErrorsReported": {
					"scope": "resource.aiscript",
					"type": "integer",
					"minimum": -1,
					"default": 100,
					"description": "Controls the maximum number of errors reported in a file. '-1' means no limit."
				},
				"aoe2_AiScript.enableCompletionHelp": {
					"scope": "resource.aiscript",
					"type": "boolean",
					"enum": [
						true,
						false
					],
					"default": true,
					"description": "Controls whether completion suggestions features will be enabled."
				},
				"aoe2_AiScript.enableParameterHelp": {
					"type": "string",
					"scope": "resource.aiscript",
					"enum": [
						"off",
						"parametersOnly",
						"full"
					],
					"default": "parametersOnly",
					"description": "Controls whether parameter help will be provided as you write commands."
				},
				"aoe2_AiScript.enableHoverHelp": {
					"scope": "resource.aiscript",
					"type": "boolean",
					"enum": [
						true,
						false
					],
					"default": true,
					"description": "Controls whether parameter help will be provided when you hover over a parameter."
				},
				"aoe2_AiScript.aiName": {
					"scope": "resource.aiscript",
					"type": "string",
					"default": "",
					"description": "Name of the ai to be edited"
				},
				"aoe2_AiScript.aiDirectory": {
					"scope": "resource.aiscript",
					"type": "string",
					"default": "${workspaceFolder}",
					"description": "Path to the directory containing the AI script '.ai' file."
				},
				"aoe2_AiScript.useLabLinter": {
					"scope": "resource.aiscript",
					"type": "boolean",
					"default": true,
					"description": "Use the bundled Python parser/linter for diagnostics instead of the extension's legacy checker."
				},
				"aoe2_AiScript.usePackageLint": {
					"scope": "resource.aiscript",
					"type": "boolean",
					"default": true,
					"description": "When using parser diagnostics, prefer package-aware linting from the nearest directory containing an .ai file."
				},
				"aoe2_AiScript.labPath": {
					"scope": "resource.aiscript",
					"type": "string",
					"default": "",
					"description": "Optional path to an AOE2 AI Parser development checkout. Empty means use the validator bundled with this extension."
				},
				"aoe2_AiScript.pythonPath": {
					"scope": "resource.aiscript",
					"type": "string",
					"default": "python",
					"description": "Python executable used to run parser diagnostics."
				}
			}
		},
		"grammars": [
			{
				"language": "aoe2aiscript",
				"scopeName": "source.per",
				"path": "./syntaxes/aoe2aiscript.tmLanguage.json"
			}
		],
		"themes": [
			{
				"label": "AOE2 AI Parser Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/aoe2-ai-parser-dark-color-theme.json"
			}
		],
		"snippets": [
			{
				"language": "aoe2aiscript",
				"path": "./snippets/aoe2aiscript.tmSnippets.json"
			}
		],
		"semanticTokenTypes": [
			{
				"id": "aoe2Action",
				"superType": "function",
				"description": "AoE2 AI action command"
			},
			{
				"id": "aoe2Fact",
				"superType": "function",
				"description": "AoE2 AI fact command"
			},
			{
				"id": "aoe2FactAction",
				"superType": "function",
				"description": "AoE2 AI fact/action command"
			},
			{
				"id": "aoe2Command",
				"superType": "function",
				"description": "AoE2 AI command or control form"
			},
			{
				"id": "aoe2StrategicNumber",
				"superType": "variable",
				"description": "AoE2 AI strategic number"
			},
			{
				"id": "aoe2Object",
				"superType": "class",
				"description": "AoE2 object or class token"
			},
			{
				"id": "aoe2Tech",
				"superType": "class",
				"description": "AoE2 technology token"
			},
			{
				"id": "aoe2Value",
				"superType": "enumMember",
				"description": "AoE2 enum or value token"
			},
			{
				"id": "aoe2LocalConstant",
				"superType": "variable",
				"description": "Local defconst declaration"
			}
		],
		"commands": [
			{
				"command": "aoe2AiScript.lintCurrentFile",
				"title": "AoE2: Lint Current File"
			},
			{
				"command": "aoe2AiScript.lintPackage",
				"title": "AoE2: Lint Package"
			},
			{
				"command": "aoe2AiScript.generatePackageReport",
				"title": "AoE2: Generate Package Report"
			},
			{
				"command": "aoe2AiScript.openLatestPackageReport",
				"title": "AoE2: Open Latest Package Report"
			},
			{
				"command": "aoe2AiScript.openSymbolDocsPreview",
				"title": "AoE2: Open Symbol Docs Preview"
			},
			{
				"command": "aoe2AiScript.openDiagnosticDocsPreview",
				"title": "AoE2: Open Diagnostic Docs Preview"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "aoe2AiScript.openSymbolDocsPreview",
					"when": "editorLangId == aoe2aiscript",
					"group": "navigation"
				}
			]
		}
	},
	"engines": {
		"vscode": "^1.30.0"
	},
	"scripts": {
		"compile": "rimraf ./languageExtension/out && tsc -p languageExtension/tsconfig.json",
		"watch": "tsc -b -w",
		"test": "node ./languageExtension/out/test/runTest.js"
	},
	"devDependencies": {
		"@types/mocha": "^5.2.0",
		"@types/node": "^8.0.0",
		"tslint": "^6.1.3",
		"typescript": "^3.1.3",
		"vscode-test": "^1.4.0"
	},
	"dependencies": {
		"levenshtein": "^1.0.5"
	}
}
