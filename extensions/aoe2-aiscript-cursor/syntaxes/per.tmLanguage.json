{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AoE2 AI Script",
  "scopeName": "source.aoe2-per",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#preprocessor" },
    { "include": "#defconst" },
    { "include": "#defrule" },
    { "include": "#commands" },
    { "include": "#strategicNumbers" },
    { "include": "#typedOperators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.aoe2-per",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aoe2-per",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aoe2-per",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "keyword.control.preprocessor.aoe2-per",
          "match": "^\\s*#(?:load|load-if-defined|load-if-not-defined|else|end-if|endif)\\b"
        }
      ]
    },
    "defconst": {
      "patterns": [
        {
          "name": "meta.definition.constant.aoe2-per",
          "match": "\\b(defconst)\\s+([-A-Za-z0-9_]+)",
          "captures": {
            "1": { "name": "storage.type.constant.aoe2-per" },
            "2": { "name": "variable.other.constant.aoe2-per" }
          }
        }
      ]
    },
    "defrule": {
      "patterns": [
        {
          "name": "storage.type.rule.aoe2-per",
          "match": "\\b(defrule)\\b"
        },
        {
          "name": "keyword.operator.arrow.aoe2-per",
          "match": "=>"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "name": "support.function.command.aoe2-per",
          "match": "(?<=\\()[-A-Za-z0-9_#]+"
        }
      ]
    },
    "strategicNumbers": {
      "patterns": [
        {
          "name": "support.constant.strategic-number.aoe2-per",
          "match": "\\bsn-[-A-Za-z0-9_]+\\b"
        }
      ]
    },
    "typedOperators": {
      "patterns": [
        {
          "name": "keyword.operator.typed.aoe2-per",
          "match": "\\b[cdgs]:[<>=!+\\-*/%]*\\b|(?:<=|>=|==|!=|<|>)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.aoe2-per",
          "match": "\\b-?\\d+\\b"
        }
      ]
    }
  }
}
