{
  "name": "aoe2-aiscript-cursor",
  "displayName": "AoE2 AI Script Cursor",
  "description": "Local AoE2 AI script language support for Cursor and VS Code.",
  "version": "0.0.1",
  "publisher": "aoe2-ai-lab",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/joerollman/aoe2-ai-parser.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "files": [
    "data/completions.json",
    "language-configuration.json",
    "LICENSE",
    "README.md",
    "src/extension.js",
    "syntaxes/per.tmLanguage.json"
  ],
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:aoe2-per"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "aoe2-per",
        "aliases": [
          "AoE2 AI Script",
          "PER"
        ],
        "extensions": [
          ".per",
          ".ai"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aoe2-per",
        "scopeName": "source.aoe2-per",
        "path": "./syntaxes/per.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^2.15.0"
  },
  "scripts": {
    "build:data": "node scripts/build-completions.mjs",
    "package": "vsce package"
  }
}
